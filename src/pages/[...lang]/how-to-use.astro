---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getCanonicalUrl,
  getLocalizedPath,
  getLocaleStaticPaths,
  resolveLocaleParam,
} from '../../i18n/locales';
import { TRANSLATIONS } from '../../i18n/translations';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = resolveLocaleParam(Astro.params.lang);
const t = TRANSLATIONS[locale];
const homeCanonical = getCanonicalUrl(locale, 'home');
const canonicalUrl = getCanonicalUrl(locale, 'howToUse');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.nav.home,
      item: homeCanonical,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.howToUse.breadcrumbCurrent,
      item: canonicalUrl,
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.howToUse.h1,
  description: t.seo.howToUseDescription,
  inLanguage: locale,
  totalTime: 'PT1M',
  tool: [
    {
      '@type': 'HowToTool',
      name: 'CompressImg Browser Image Compressor',
    },
  ],
  step: t.howToUse.steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.description,
  })),
};
---

<BaseLayout
  locale={locale}
  routeKey="howToUse"
  title={t.seo.howToUseTitle}
  description={t.seo.howToUseDescription}
  t={t}
  schemas={[breadcrumbSchema, howToSchema]}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs
      homeLabel={t.nav.home}
      homeHref={getLocalizedPath(locale, 'home')}
      currentLabel={t.howToUse.breadcrumbCurrent}
    />

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">
        {t.howToUse.h1}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-inkmuted leading-relaxed">
        {t.howToUse.intro}
      </p>
    </header>

    <section aria-labelledby="steps-heading" class="mb-12">
      <h2 id="steps-heading" class="text-xl sm:text-2xl font-extrabold text-ink mb-5">
        {t.howToUse.stepsHeading}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {t.howToUse.steps.map((step) => (
          <div class="rounded-3xl border border-line bg-card p-6 shadow-soft">
            <h3 class="text-base sm:text-lg font-bold text-ink">
              {step.title}
            </h3>
            <p class="mt-2 text-sm sm:text-base text-inkmuted leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="tips-heading" class="mb-10">
      <h2 id="tips-heading" class="text-xl sm:text-2xl font-extrabold text-ink mb-5">
        {t.howToUse.tipsHeading}
      </h2>
      <div class="space-y-4">
        {t.howToUse.tips.map((tip) => (
          <div class="rounded-2xl border border-line bg-subtle/45 p-5">
            <h3 class="text-base font-bold text-ink">{tip.title}</h3>
            <p class="mt-1.5 text-sm sm:text-base text-inkmuted leading-relaxed">{tip.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="flex justify-center pt-2">
      <a
        href={getLocalizedPath(locale, 'home')}
        class="inline-flex items-center gap-2 rounded-2xl bg-[#FFC7C7] px-7 py-3.5 text-base font-extrabold text-[#242236] shadow-sm hover:bg-[#F5B0B0] spring-hover"
      >
        <span>{t.howToUse.ctaButton}</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </article>
</BaseLayout>
